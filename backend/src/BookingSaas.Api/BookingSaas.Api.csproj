<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BookingSaas.Api</RootNamespace>
    <UserSecretsId>bookingsaas-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <!--
      FluentValidation's own ASP.NET MVC auto-validation integration (the old
      FluentValidation.AspNetCore package) is deprecated/unmaintained upstream, so validators are
      invoked explicitly (IValidator<T>.ValidateAndThrowAsync) from a small controller base
      instead - see Controllers/ApiControllerBase.cs. FluentValidation core + DI registration
      already flow in transitively from the Application project reference below.
    -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BookingSaas.Application\BookingSaas.Application.csproj" />
    <ProjectReference Include="..\BookingSaas.Infrastructure\BookingSaas.Infrastructure.csproj" />
  </ItemGroup>

</Project>

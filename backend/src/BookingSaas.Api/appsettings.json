{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=bookingsaas;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Secret": "REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES",
    "Issuer": "BookingSaas.Api",
    "Audience": "BookingSaas.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Stripe": {
    "SecretKey": "sk_test_placeholder",
    "WebhookSecret": "whsec_placeholder",
    "PublishableKey": "pk_test_placeholder",
    "SubscriptionPriceId": "price_placeholder"
  },
  "Paystack": {
    "SecretKey": "sk_test_placeholder",
    "PublicKey": "pk_test_placeholder"
  },
  "Frontend": {
    "WebAppUrl": "http://localhost:5173",
    "AdminAppUrl": "http://localhost:5174"
  }
}

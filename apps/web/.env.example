# Base URL of the BookingSaas backend API (no trailing slash), e.g. http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000/api

# Stripe publishable key (pk_test_... / pk_live_...) used by @stripe/react-stripe-js
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Paystack public key (pk_test_... / pk_live_...) used by react-paystack
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
